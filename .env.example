# ── Google Cloud Platform ──────────────────────────────────────────────────────
# ID del proyecto GCP donde está tu BigQuery
GCP_PROJECT_ID=your-gcp-project-id

# Nombre del dataset de BigQuery a consultar
BQ_DATASET_ID=your-bigquery-dataset-id

# Región de tus recursos GCP (por defecto: europe-southwest1)
GCP_LOCATION=europe-southwest1

# ── Modelo ─────────────────────────────────────────────────────────────────────
# gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# ── Credenciales GCP ───────────────────────────────────────────────────────────
# Opción A — Ruta al fichero JSON de la cuenta de servicio
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/a/service-account.json
#
# Opción B — Application Default Credentials (recomendado para desarrollo local)
# Ejecuta: gcloud auth application-default login
# No es necesario definir ninguna variable adicional.

# ── Aplicación ─────────────────────────────────────────────────────────────────
APP_NAME=bq_agent

# ── Branding (white-label) ───────────────────────────────────────────────────────
# Cliente activo. Debe coincidir con una sección de branding/clientes.toml.
# Ejemplos incluidos: default | acme | globex | caixabank | accenture | bbva
CLIENT_ID=default
